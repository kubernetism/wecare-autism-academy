# Copy to .env.local for local development. Never commit real values.

# Postgres. Local: `npm run db:up` starts the Docker database below.
# Neon: use the POOLED connection string (host contains "-pooler") here.
DATABASE_URL=postgres://wecare:wecare@127.0.0.1:5433/wecare
# Neon only: the DIRECT (unpooled) connection string, used for migrations.
# DATABASE_URL_UNPOOLED=

# Better Auth. Generate the secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Public URL of the site (used for auth callbacks and metadata).
BETTER_AUTH_URL=http://localhost:3000

# IANA time zone the clinic works in, used for "today" and displayed times.
CLINIC_TIME_ZONE=UTC

# Only for `npm run db:create-admin` (first administrator account).
# ADMIN_EMAIL=
# ADMIN_NAME=
# ADMIN_PASSWORD=

# Private file storage for medical files (local driver). Outside public/, gitignored.
# FILE_STORAGE_DIR=.data/uploads
